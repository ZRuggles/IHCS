<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let real files/directories resolve normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send all other routes to React app entry
  RewriteRule . /index.html [L]
</IfModule>
