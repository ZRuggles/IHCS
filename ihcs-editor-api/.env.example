# ---- Supabase ----
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service role key. SERVER ONLY. Bypasses RLS — never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key. Safe to expose; used only to verify user JWTs.
SUPABASE_ANON_KEY=
# Direct Postgres connection string (Supabase > Settings > Database).
DATABASE_URL=

# ---- Storage ----
SUPABASE_STORAGE_BUCKET=site-images

# ---- Server ----
PORT=8787
NODE_ENV=development

# Comma-separated list of origins allowed to call this API.
# Must include the live site and any preview/local origins.
# Vite claims 5173 by default but walks upward when it is taken, so a
# second dev server lands on 5174. A port missing here surfaces as a
# CORS preflight failure in the browser console rather than a clear
# error, so list the whole local range.
# In production this must list the CUSTOM DOMAIN, not just the
# onrender.com URL — that is the origin browsers actually send.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://innovationhealthcaresolutions.com,https://www.innovationhealthcaresolutions.com,https://ihcs.onrender.com

# ---- Publishing ----
# Render Deploy Hook for the static site. Publishing POSTs here to
# trigger a rebuild that picks up the new content.json.
RENDER_DEPLOY_HOOK_URL=
